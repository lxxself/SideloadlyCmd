include README.md README.en.md LICENSE CONTRIBUTING.md SECURITY.md CHANGELOG.md
include scripts/sideloadlycmd
recursive-include scripts *.py
recursive-include docs *.md
recursive-include tests *.py
recursive-include .agents/skills/sideloadly-cli *.md *.yaml
prune .local-dev
prune analysis
prune research
prune dist
prune build
global-exclude __pycache__ *.py[cod] .DS_Store *.ipa *.mobileprovision *.p12 *.p8 *.pfx *.pem *.keychain* .env .env.*
